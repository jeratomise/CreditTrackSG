{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/server" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/trigger-reminders", "schedule": "0 1 * * *" },
    { "path": "/api/trigger-weekly", "schedule": "0 1 * * 1" }
  ]
}
