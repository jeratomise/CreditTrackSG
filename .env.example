# Copy to .env for local dev:  copy .env.example .env
# Never commit .env. Production values belong in the Vercel project, not in git.
#
# VITE_ names are inlined into the browser bundle. Only the two public Supabase
# values below may use that prefix. Do not create VITE_GEMINI_API_KEY or
# VITE_ anything for Stripe, Resend, the service role, or CRON_SECRET.

# --- Browser (public) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server (same URL and anon key as above; also set these on Vercel) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Required for bill extraction and insights.
GEMINI_API_KEY=

# Server-only email.
RESEND_API_KEY=
EMAIL_FROM=

# Server-only billing. Webhook path is /api/stripe-webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID_MONTHLY=
STRIPE_PRO_PRICE_ID_ANNUAL=

# Server-only. Cron endpoints refuse to run when this is empty.
CRON_SECRET=

# Links in emails and Stripe return URLs.
APP_URL=https://credittrack.elitex.cc
